# JokerAIRunner Docker 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# ========================================
# MidScene 执行配置
# ========================================
# 是否显示浏览器界面（true/false）
MIDSCENE_HEADED=false
# 是否保持窗口开启（true/false）
MIDSCENE_KEEP_WINDOW=false
# 执行超时时间（秒）
MIDSCENE_TIMEOUT=120

# ========================================
# MidScene AI 模型配置
# ========================================
MIDSCENE_MODEL_BASE_URL="https://api.siliconflow.cn/v1"
MIDSCENE_MODEL_API_KEY="your-api-key"
MIDSCENE_MODEL_NAME="Qwen/Qwen2.5-VL-32B-Instruct"
MIDSCENE_MODEL_FAMILY="qwen2.5-vl"

# ========================================
# 测试环境配置
# ========================================
# API 基础 URL
BASE_URL="https://api.example.com"
# 测试环境标识（development/staging/production）
TEST_ENV=development

# ========================================
# Docker 配置
# ========================================
# 是否在 Docker 中运行（自动设置，无需手动修改）
RUN_IN_DOCKER=true
